{
    "name": "it-gouvernance/bitwardensend",
    "description": "Bitwarden Send plugin for GLPI",
    "license": "GPL-3.0-or-later",
    "type": "glpi-plugin",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "glpi-project/rector-glpi": "^1.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GlpiPlugin\\Bitwardensend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Bitwardensend\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
