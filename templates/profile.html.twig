<form method="post" action="{{ path('plugins/bitwardensend/front/profile.form.php') }}">
   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
   <input type="hidden" name="profiles_id" value="{{ profiles_id }}">

   <div class="card-body">
      <div class="d-flex align-items-center gap-2 mb-3">
         <i class="ti ti-shield-lock text-secondary"></i>
         <span class="badge bg-blue-lt">Bitwarden Send</span>
      </div>

      <div class="list-group list-group-flush border rounded">
         {% for right in rights %}
            <label class="list-group-item d-flex align-items-center justify-content-between">
               <span class="d-flex align-items-center">
                  <i class="ti {{ right.icon }} me-2 text-secondary"></i>
                  <span class="form-check-label">{{ right.label }}</span>
               </span>
               <span class="form-check form-switch mb-0">
                  <input type="checkbox" class="form-check-input" role="switch"
                         name="rights[{{ right.value }}]" value="1"
                         {{ right.checked ? 'checked' : '' }}
                         {{ can_update ? '' : 'disabled' }}>
               </span>
            </label>
            {% if loop.first %}
               <div class="list-group-item bg-body-tertiary">
                  <div class="d-flex align-items-start text-secondary small">
                     <i class="ti ti-info-circle me-2 mt-1"></i>
                     <span>{{ read_hint }}</span>
                  </div>
               </div>
            {% endif %}
         {% endfor %}
      </div>
   </div>

   {% if can_update %}
      <div class="card-footer text-end">
         <button type="submit" name="update" value="1" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}
         </button>
      </div>
   {% endif %}
</form>
